cabal-version:      3.4
name:               raft-consensus-wal
version:            0.1.0.0
synopsis:           Write-ahead log support for the raft-consensus library
-- description:
homepage:           https://github.com/LaurentRDC/distributed-consensus
license:            BSD-3-Clause
license-file:       LICENSE
author:             Laurent P. René de Cotret
maintainer:         laurent.decotret@outlook.com
copyright:          Laurent P. René de Cotret
category:           Distributed Systems, Consensus
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

-- extra-source-files:

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-uni-patterns
                 -Wincomplete-record-updates
                 -Wredundant-constraints
                 -fhide-source-paths
                 -Wpartial-fields
                 -Wunused-packages

library
    import:           warnings
    exposed-modules:  Distributed.Consensus.Raft.WAL
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:    base >= 4.18 && <4.23
                    , bytestring
                    , binary ^>=0.8
                    , containers
                    , directory
                    , exceptions
                    , filepath >=1.5 && <1.6
                    , file-io
                    , raft-consensus ^>=0.1
                    , wal ^>=0.1