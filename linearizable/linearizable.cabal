cabal-version:      3.4
name:               linearizable
version:            0.1.0.0
synopsis:           Linearizability checker
-- description:
homepage:           https://github.com/LaurentRDC/distributed-consensus
license:            BSD-3-Clause
license-file:       LICENSE
author:             Laurent P. René de Cotret
maintainer:         laurent.decotret@outlook.com
copyright:          Laurent P. René de Cotret
category:           Distributed Systems
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

-- extra-source-files:

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-uni-patterns
                 -Wincomplete-record-updates
                 -Wredundant-constraints
                 -fhide-source-paths
                 -Wpartial-fields
                 -Wunused-packages

library
    import:           warnings
    exposed-modules:  Control.Concurrent.Linearizable
    build-depends:    base >= 4.18 && <4.23
                    , containers >=0.7 && <0.9
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite linearizable-test
    import:           warnings
    default-language: Haskell2010
    ghc-options:      -rtsopts -threaded "-with-rtsopts=-N"
    type:             exitcode-stdio-1.0
    hs-source-dirs:   tests
    main-is:          Main.hs
    other-modules:    Test.Control.Concurrent.Linearizable
    build-depends:    base
                    , tasty ^>=1.5
                    , tasty-hunit ^>=0.10
                    , linearizable
