cabal-version:      3.4
name:               hs-raft
version:            0.1.0.0
synopsis:           Haskell implementation of the Raft consensus protocol
-- description:
homepage:           https://github.com/LaurentRDC/hs-raft
license:            BSD-3-Clause
license-file:       LICENSE
author:             Laurent P. René de Cotret
maintainer:         laurent.decotret@outlook.com
copyright:          Laurent P. René de Cotret
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/LaurentRDC/hs-raft

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-uni-patterns
                 -Wincomplete-record-updates
                 -Wredundant-constraints
                 -fhide-source-paths
                 -Wpartial-fields

library
    import:           warnings
    exposed-modules:  Network.Consensus.Raft
    build-depends:    base >= 4.14 && <4.23
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite hs-raft-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   tests
    main-is:          Main.hs
    build-depends:    base,
                      hs-raft 
