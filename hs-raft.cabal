cabal-version:      3.4
name:               hs-raft
version:            0.1.0.0
synopsis:           Haskell implementation of the Raft consensus protocol
-- description:
homepage:           https://github.com/LaurentRDC/hs-raft
license:            BSD-3-Clause
license-file:       LICENSE
author:             Laurent P. René de Cotret
maintainer:         laurent.decotret@outlook.com
copyright:          Laurent P. René de Cotret
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/LaurentRDC/hs-raft

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-uni-patterns
                 -Wincomplete-record-updates
                 -Wredundant-constraints
                 -fhide-source-paths
                 -Wpartial-fields

library
    import:           warnings
    exposed-modules:  Network.Consensus.Raft
    other-modules:    Network.Consensus.Raft.Algorithm
                      Network.Consensus.Raft.Spec
                      Network.Consensus.Raft.Timer
                      Network.Consensus.Raft.Trans
    -- GHC 9.6+ (base 4.18+) is required to infer types properly when
    -- using io-classes
    build-depends:    base >= 4.18 && <4.23
                    , containers
                    , io-classes ^>=1.9
                    , microlens-platform ^>=0.4
                    , random ^>=1.3
                    , transformers ^>=0.6
                    , vector >= 0.10 && <0.14
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite hs-raft-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   tests
    main-is:          Main.hs
    other-modules:    Test.Network.Consensus.Raft
    build-depends:    base >= 4.18 && <4.23
                    , bytestring
                    , containers
                    , hs-raft
                    , io-classes ^>=1.9
                    , io-sim ^>=1.9
                    , hedgehog ^>=1.7
                    , random ^>=1.3
                    , tasty ^>=1.5
                    , tasty-hedgehog ^>=1.4
                    , tasty-hunit ^>=0.10
