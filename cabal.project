packages: raft-consensus/raft-consensus.cabal
          raft-consensus-wal/raft-consensus-wal.cabal
          wal/wal.cabal
          distributed-process-raft-consensus/distributed-process-raft-consensus.cabal
          examples/distributed-filesystem/distfs.cabal

program-options
    ghc-options: +RTS -A64m -RTS

jobs: $ncpus
semaphore: True

test-show-details: streaming
tests: True
benchmarks: True
